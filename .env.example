# Vorlage: nach .env kopieren. .env wird nicht eingecheckt.
# Geheimnisse (ELEVENLABS_API_KEY für npm run stimmen) gehören nur in .env.local – nie in diese Datei.

# Firebase Realtime Database, über die sich die Geräte finden (öffentlich; Schutz über firebase/database.rules.json).
# Leer lassen: Räume funktionieren dann nur zwischen Tabs desselben Browsers (zum Ausprobieren).
VITE_FIREBASE_DATABASE_URL=https://politik-duell-quiz-default-rtdb.europe-west1.firebasedatabase.app

# Optional: STUN-Server für Direktverbindungen übers Internet, durch Komma getrennt (z. B. stun:stun.example.eu:3478).
# Ohne: direkt nur im selben Netz, sonst Weiterleitung über Firebase.
VITE_STUN_URLS=
